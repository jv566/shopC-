                            <ColumnDefinition Width="0.48*" />
                            <ColumnDefinition Width="0.04*" />
                            <ColumnDefinition Width="0.48*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Image Source="/Assets/Images/category-badge-background.png"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="0.25" ScaleY="0.25" />
                                </Image.RenderTransform>
                            </Image>
                            <Image Source="/Assets/Images/Keting.png"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   RenderTransformOrigin="0.05 0.04">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="0.18" ScaleY="0.18" />
                                </Image.RenderTransform>
                            </Image>
                            <Image Source="/Assets/Images/ellipse.png"
