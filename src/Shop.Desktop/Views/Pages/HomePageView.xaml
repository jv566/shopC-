                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Padding="0">
                                <Image Source="/Assets/Images/category-chair-icon.png"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       RenderTransformOrigin="0.5 0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="0.73" ScaleY="0.73" />
                                    </Image.RenderTransform>
                                </Image>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.7*" />
                        <RowDefinition Height="0.3*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          x:Name="CarouselSlideViewport"
                          ClipToBounds="True"
                          Margin="10 0 10 0"
                          MouseEnter="OnCarouselMouseEnter"
                          MouseLeave="OnCarouselMouseLeave">

                        <!-- 当前图片层 -->
                        <Grid x:Name="CurrentSlideLayer">
                            <Rectangle x:Name="CurrentSlideRect"
                                       RadiusX="10" RadiusY="10"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Stretch="Fill">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding CurrentBanner.ImageSource}"
                                                Stretch="UniformToFill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="CurrentSlideTransform"/>
                            </Grid.RenderTransform>
                        </Grid>

                        <!-- 下一张图片层 -->
                        <Grid x:Name="NextSlideLayer" Visibility="Collapsed">
                            <Rectangle x:Name="NextSlideRect"
                                       RadiusX="10" RadiusY="10"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding CurrentBanner.ImageSource}"
                                                Stretch="UniformToFill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="NextSlideTransform"/>
                            </Grid.RenderTransform>
                        </Grid>

                        <!-- 底部指示器 -->
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,14"
                                Background="#26FFFFFF"
                                CornerRadius="14"
                                Padding="10,6">
                            <StackPanel x:Name="CarouselIndicatorPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="5 10 0 0"
                                    Padding="0">
                                <Border CornerRadius="5"
                                        Padding="20"
                                        Margin="0"
                                        Background="#F6F8FC">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="122"
                                                Height="92"
                                                Background="#E7EEF7"
                                                CornerRadius="8"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Image Source="/Assets/Images/feature-category-left.png"
                                                    Stretch="Uniform"
                                                    SnapsToDevicePixels="True" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="客厅分类"
                                                        FontSize="20"
                                                        FontWeight="SemiBold"
                                                        Foreground="#202020" />
                                            <TextBlock Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                                        Margin="0,10,0,0"
                                                        FontSize="14"
                                                        Foreground="#A8AFBA"
                                                        TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>

                            <Button Grid.Column="2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="0 10 5 0"
                                    Padding="0">
                                <Border CornerRadius="5"
