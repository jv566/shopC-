                        <RowDefinition Height="0.031*" />
                        <RowDefinition Height="0.227*" />
                        <RowDefinition Height="0.031*" />
                        <RowDefinition Height="0.227*" />
                        <RowDefinition Height="0.031*" />
                        <RowDefinition Height="0.227*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
