<UserControl x:Class="Shop.Desktop.Views.Pages.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid Background="#FFEAEAEA" Margin="10">
        <Border BorderBrush="Black" BorderThickness="1" Padding="24,22,24,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                

                <Grid Grid.Row="0" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,20,0">
                        <Border BorderBrush="Black" BorderThickness="1" Padding="14,12,14,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock x:Name="ProductModelText" Text="{Binding ProductModelText}"
                                                   
                                                   FontSize="24"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock
                                                   Text="     "
                                                   FontSize="24"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="ProductPriceText" Text="{Binding ProductPriceText}"
                                                   
                                                   FontSize="24"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock x:Name="ColorIndexText"
                                               Grid.Column="1"
                                               Text="1/1"
                                               FontSize="16"
                                               VerticalAlignment="Top"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,14">
                                    <Border BorderBrush="Black"
                                            BorderThickness="1"
                                            Background="#FFF7F7F7"
                                            Padding="10">
                                        <Grid x:Name="ProductImageViewport" ClipToBounds="True">
                                            <Grid x:Name="CurrentProductSlideLayer">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="CurrentProductSlideTransform" />
                                                </Grid.RenderTransform>

                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="产品主图占位"
                                                               FontSize="34"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="CurrentColorNameText"
                                                               Text="颜色：默认色"
                                                               FontSize="28"
                                                               Margin="0,14,0,0"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ProductImageHintText"
                                                               Text="图片接口: ColorImageUrl（待后端返回）"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,12,0,0"
                                                               Foreground="#FF666666" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid x:Name="NextProductSlideLayer" Visibility="Collapsed">
                                                <Grid.RenderTransform>
                                                    <TranslateTransform x:Name="NextProductSlideTransform" />
                                                </Grid.RenderTransform>

                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="产品主图占位"
                                                               FontSize="34"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="NextColorNameText"
                                                               Text=""
                                                               FontSize="28"
                                                               Margin="0,14,0,0"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="NextProductImageHintText"
                                                               Text=""
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,12,0,0"
                                                               Foreground="#FF666666" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="PrevImageButton"
                                            Content="◀"
                                            Width="38"
                                            Height="64"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0"
                                            FontSize="24"
                                            Click="OnPrevImageClicked" />

                                    <Button x:Name="NextImageButton"
                                            Content="▶"
                                            Width="38"
                                            Height="64"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            FontSize="24"
                                            Click="OnNextImageClicked" />
                                </Grid>

                                <StackPanel Grid.Row="2" Orientation="Vertical">
                                    <TextBlock Text="颜色（后端返回：ColorName + ColorImageUrl）"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8" />

                                    <ItemsControl x:Name="ColorOptionItems" ItemsSource="{Binding ColorOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ColorName}"
                                                        Tag="{Binding Index}"
                                                        Height="64"
                                                        MinWidth="140"
                                                        Margin="9,0,9,8"
                                                        FontSize="26"
                                                        BorderBrush="Black"
                                                        BorderThickness="{Binding ButtonBorderThickness}"
                                                        Background="{Binding ButtonBackground}"
                                                        Click="OnColorOptionClicked" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2.2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Margin="0,0,0,14">
                            <TextBlock Text="AI 客服"
                                       FontSize="34"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,14,0,0" />
                        </Border>

                        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Height="28" Margin="0,0,0,14" />
                        <Border Grid.Row="2" BorderBrush="Black" BorderThickness="1" Height="28" Margin="0,0,0,14" />
                        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Height="28" Margin="0,0,0,14" />
                        <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1" Height="28" Margin="0,0,0,14" />

                        <UniformGrid Grid.Row="5" Columns="2" Rows="2" Margin="2,0,2,0">
                            <Button Content="卖点图 1" Height="56" Margin="5" FontSize="30" />
                            <Button Content="卖点图 2" Height="56" Margin="5" FontSize="30" />
                            <Button Content="卖点图 3" Height="56" Margin="5" FontSize="30" />
                            <Button Content="卖点图 4" Height="56" Margin="5" FontSize="30" />
                        </UniformGrid>
                    </Grid>
                </Grid>
            
                <Button Grid.Row="1"
                        Content="返回上一级"
                        Width="130"
                        Height="34"
                        HorizontalAlignment="Left"
                        FontSize="20"
                        Click="OnBackToListClicked" />


            </Grid>
        </Border>
    </Grid>
</UserControl>




