<UserControl x:Class="Shop.Desktop.Views.Pages.ProductPanoramaReplacementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid Background="#FFEAEAEA" Margin="8">
        <Border BorderBrush="Black" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.45*" />
                    <ColumnDefinition Width="4.55*" />
                    <ColumnDefinition Width="2.25*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="2.1*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="8,8,8,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Button Content="区域场景" Height="42" FontSize="28" Margin="18,0,18,8" />
                                <TextBlock Text="客厅/餐厅/卧室"
                                           FontSize="30"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="。。。"
                                           FontSize="30"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="点击区域时，显示&#x0a;该区域分类下不&#x0a;同风格的场景。"
                                           FontSize="29"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button Content="产品库" Height="42" FontSize="28" Margin="18,0,18,8" />
                                <TextBlock Text="餐桌  。。。"
                                           FontSize="30"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="切换场景时，产&#x0a;品库自动展示&#x0a;对应的产品分&#x0a;类，点击产品替&#x0a;换场景中的产&#x0a;品"
                                           FontSize="29"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1,1,0,0" Background="#FFE9E9E9" Padding="10">
                            <Border BorderBrush="Black" BorderThickness="1" Background="#FFF7F7F7">
                                <wv2:WebView2 x:Name="PanoramaProduct3DWebView" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="全景场景"
                            Width="106"
                            Height="54"
                            FontSize="30"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,12" />

                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,6">
                        <wv2:WebView2 x:Name="PanoramaWebView" />
                    </Border>
                </Grid>

                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Content="3D 产品&#x0a;添加购物车"
                            Width="150"
                            Height="92"
                            FontSize="31"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="返回"
                                Height="58"
                                FontSize="34"
                                Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Content="保存, 分享效&#x0a;果 (二维码)"
                                Height="58"
                                FontSize="31"
                                Margin="6,0,0,0" />
                    </Grid>
                </Grid>
                <Button Grid.Column="0"
                        Content="返回"
                        Width="92"
                        Height="42"
                        FontSize="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="8,0,0,8"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Background="#E6FFFFFF"
                        Panel.ZIndex="2"
                        Click="OnBackClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
