<UserControl x:Class="Shop.Desktop.Views.Pages.Product3DShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/Product3DShowCaseBackground.png" />
        </Grid.Background>
        <Grid.RowDefinitions>
                <RowDefinition Height="0.115*" />
                <RowDefinition Height="0.772*" />
                <RowDefinition Height="0.113*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.06*" />
                    <ColumnDefinition Width="0.053*" />
                    <ColumnDefinition Width="0.267*" />
                    <ColumnDefinition Width="0.558*" />
                    <ColumnDefinition Width="0.06*" />
                </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Button Content="床" FontSize="20" Margin="0 0 0 25" Height="80" />
                    <Button Content="沙发" FontSize="20" Margin="0 0 0 25" Height="80"/>
                    <Button Content="餐桌" FontSize="20" Height="80" />
                </StackPanel>

                <Button Content="返回"
                        Height="80"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Width="92"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Background="#E6FFFFFF"
                        Click="OnBackClick" />
            </Grid>
                
            <Grid Grid.Column="2">
            </Grid>

            <Grid Grid.Column="3">
                <hx:Viewport3DX x:Name="view1"
                                ShowCoordinateSystem="True"
                                ShowFrameRate="True"
                                CameraRotationMode="Trackball">
                    <hx:DirectionalLight3D Direction="-1,-1,-2" Color="White"/>
                    <hx:DirectionalLight3D Direction="1,1,2" Color="White"/>
                    <hx:AmbientLight3D Color="#FFFFFF"/>
                </hx:Viewport3DX>

                <Button Content="添加购物车"
                        Width="80"
                        Height="80"
                        FontSize="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,20"
                        Background="#E6FFFFFF" />
                </Grid>
            </Grid>
        </Grid>
</UserControl>