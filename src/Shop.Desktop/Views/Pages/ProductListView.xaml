<UserControl x:Class="Shop.Desktop.Views.Pages.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Shop.Desktop.Models"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid Background="#FFEAEAEA" Margin="14">
        <Border BorderBrush="Black" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    

                    <Border Grid.Row="0" BorderBrush="Black" BorderThickness="1" Padding="8,10">
                        <StackPanel>
                            <TextBlock x:Name="CurrentCategoryText" Text="{Binding CurrentCategoryText}"
                                       FontSize="22"
                                       Margin="4,0,0,8" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                <ItemsControl x:Name="PrimaryCategoryItems" ItemsSource="{Binding CategoryTree}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProductCategoryGroup}">
                                            <Expander Margin="0,0,0,8"
                                                      BorderThickness="1"
                                                      BorderBrush="Black"
                                                      Tag="{Binding PrimaryCategory.Id}"
                                                      Loaded="OnPrimaryCategoryLoaded"
                                                      Expanded="OnPrimaryCategoryExpanded">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding PrimaryCategory.DisplayName}" FontSize="22" />
                                                </Expander.Header>

                                                <ItemsControl ItemsSource="{Binding SecondaryCategories}" Margin="8,6,8,8">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:ProductCategoryOption}">
                                                            <Button Content="{Binding DisplayName}"
                                                                    Tag="{Binding}"
                                                                    Click="OnSecondaryCategoryClicked"
                                                                    Height="34"
                                                                    FontSize="18"
                                                                    Margin="0,0,0,6" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    
                    <Button Grid.Row="1"
                            Content="返回"
                            Width="58"
                            Height="32"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            FontSize="22"
                            Click="OnBackClicked" />

                </Grid>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProductItems" ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="200"
                                        Margin="0,0,20,20"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Tag="{Binding}"
                                        Click="OnProductClicked">
                                    <StackPanel>
                                        <Border Width="180" Height="130" BorderBrush="Black" BorderThickness="1">
                                            <Grid>
                                                <TextBlock Text="图片"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="28" />
                                                <TextBlock Text="{Binding ImageUrl, StringFormat=接口: {0}}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Bottom"
                                                           Margin="6,0,6,6"
                                                           Foreground="#FF666666"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding ModelName}"
                                                   FontSize="16"
                                                   Margin="12,8,0,0" />

                                        <TextBlock Text="{Binding SalePrice, StringFormat=￥{0:F2}}"
                                                   FontSize="12"
                                                   Margin="0,0,0,8" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>


