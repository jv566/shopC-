<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.HomePage"
             Title="Shop"
             x:DataType="vm:HomePageViewModel">

    <ScrollView>
        <Grid>
            <!-- Background -->
            <Image Source="home_page_background.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />

            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Title Logo -->
                <Image Source="home_title_logo.png"
                       HeightRequest="60"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <!-- Banner Carousel -->
                <Border Stroke="#E0E0E0"
                        StrokeShape="RoundRectangle 16"
                        Padding="0"
                        HeightRequest="200"
                        BackgroundColor="#80000000">
                    <Grid>
                        <Image Source="{Binding CurrentBanner.ImagePath}"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                        <Label Text="{Binding CurrentBanner.Title}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="White"
                               BackgroundColor="#80000000"
                               Padding="12,8"
                               VerticalOptions="End"
                               HorizontalOptions="Start"
                               Margin="12" />
                    </Grid>
                </Border>

                <Label Text="{Binding BannerIndexText}"
                       HorizontalOptions="Center"
                       FontSize="12"
                       TextColor="White" />

                <!-- Category Grid -->
                <Label Text="商品分类"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="White" />

                <CollectionView ItemsSource="{Binding Categories}"
                                SelectionMode="None"
                                HeightRequest="280">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         VerticalItemSpacing="12"
                                         HorizontalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:ProductCategoryOption">
                            <Border Stroke="#E0E0E0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="16"
                                    BackgroundColor="#CCFFFFFF">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomePageViewModel}}, Path=NavigateToProductListCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                           Aspect="AspectFill"
                                           Opacity="0.3" />
                                    <VerticalStackLayout HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Spacing="8">
                                        <Image Source="category_chair_icon.png"
                                               HeightRequest="40"
                                               Aspect="AspectFit" />
                                        <Label Text="{Binding DisplayName}"
                                               HorizontalOptions="Center"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#333" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Quick Actions -->
                <Label Text="快捷功能"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="White" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">
                    <Button Grid.Column="0"
                            Grid.Row="0"
                            Text="VR 全景"
                            ImageSource="home_vr_library_button.png"
                            ContentLayout="Left,8"
                            Command="{Binding NavigateToPanoramaCommand}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="56" />
                    <Button Grid.Column="1"
                            Grid.Row="0"
                            Text="3D 展示"
                            ImageSource="home_3d_preview_bed.png"
                            ContentLayout="Left,8"
                            Command="{Binding NavigateTo3DShowcaseCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="56" />
                    <Button Grid.Column="0"
                            Grid.Row="1"
                            Text="户型设计"
                            ImageSource="home_floorplan_library_button.png"
                            ContentLayout="Left,8"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="56" />
                    <Button Grid.Column="1"
                            Grid.Row="1"
                            Text="历史订单"
                            ImageSource="home_history_orders_button.png"
                            ContentLayout="Left,8"
                            BackgroundColor="#9C27B0"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="56" />
                </Grid>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
