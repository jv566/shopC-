<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             xmlns:cvt="clr-namespace:Shop.Maui.Converters"
             x:Class="Shop.Maui.Views.HomePage"
             Title="Shop"
             BackgroundColor="#0a1628"
             x:DataType="vm:HomePageViewModel">

    <ContentPage.Resources>
        <cvt:BannerDotConverter x:Key="BannerDotConverter" />
    </ContentPage.Resources>

    <Grid>
        <Image Source="home_page_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="0.147*,0.053*,0.604*,0.114*,0.082*">

            <!-- Row 0: Title Logo -->
            <Grid Grid.Row="0">
                <Image Source="home_title_logo.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       HeightRequest="80" />
            </Grid>

            <!-- Row 1: Spacer -->

            <!-- Row 2: Main Content -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="0.063*,0.317*,0.497*,0.312*,0.066*">

                <!-- Col 0: Left Spacer -->

                <!-- Col 1: Category Grid (4 rows x 2 cols = 8 items) -->
                <Grid Grid.Column="1"
                      RowDefinitions="0.227*,0.031*,0.227*,0.031*,0.227*,0.031*,0.227*">
                    <!-- Row 0 -->
                    <Grid Grid.Row="0" ColumnDefinitions="0.48*,0.04*,0.48*">
                        <Grid Grid.Column="0">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="床"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="bed" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="沙发"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="sofa" />
                        </Grid>
                    </Grid>
                    <!-- Row 2 -->
                    <Grid Grid.Row="2" ColumnDefinitions="0.48*,0.04*,0.48*">
                        <Grid Grid.Column="0">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="桌子"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="table" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="衣柜"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="wardrobe" />
                        </Grid>
                    </Grid>
                    <!-- Row 4 -->
                    <Grid Grid.Row="4" ColumnDefinitions="0.48*,0.04*,0.48*">
                        <Grid Grid.Column="0">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="定制柜"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="8,4,0,0"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="custom" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="床"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="bed" />
                        </Grid>
                    </Grid>
                    <!-- Row 6 -->
                    <Grid Grid.Row="6" ColumnDefinitions="0.48*,0.04*,0.48*">
                        <Grid Grid.Column="0">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="沙发"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="sofa" />
                        </Grid>
                        <Grid Grid.Column="2">
                            <Image Source="category_badge_background.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   HeightRequest="30" />
                            <Label Text="桌子"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   Margin="10,4,0,0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Image Source="ellipse.png"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   HeightRequest="30"
                                   Opacity="0.6" />
                            <ImageButton Source="category_chair_icon.png"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="End"
                                         HeightRequest="50"
                                         WidthRequest="50"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="table" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Col 2: Carousel + Sub-cards -->
                <Grid Grid.Column="2"
                      RowDefinitions="0.7*,0.3*"
                      Margin="12,0,12,0">

                    <!-- Carousel -->
                    <Border Grid.Row="0"
                            StrokeShape="RoundRectangle 10"
                            Margin="10,0,10,0">
                        <Grid>
                            <Image Source="{Binding CurrentBanner.ImagePath}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />

                            <Border BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    Margin="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PrevBannerCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#x276E;"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Border BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NextBannerCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#x276F;"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Border HorizontalOptions="Center"
                                    VerticalOptions="End"
                                    Margin="0,0,0,14"
                                    BackgroundColor="#26FFFFFF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6">
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex" Converter="{StaticResource BannerDotConverter}" ConverterParameter="0" />
                                        </Border.BackgroundColor>
                                    </Border>
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex" Converter="{StaticResource BannerDotConverter}" ConverterParameter="1" />
                                        </Border.BackgroundColor>
                                    </Border>
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex" Converter="{StaticResource BannerDotConverter}" ConverterParameter="2" />
                                        </Border.BackgroundColor>
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Sub-cards -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,20,*"
                          Margin="0,6,0,0">

                        <!-- Left sub-card -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 5"
                                Padding="20"
                                BackgroundColor="#F6F8FC"
                                Margin="5,10,0,0">
                            <Grid ColumnDefinitions="122,*">
                                <Border WidthRequest="122"
                                        HeightRequest="92"
                                        BackgroundColor="#E7EEF7"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Image Source="feature_category_left.png"
                                           Aspect="AspectFit" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0,0,0"
                                                     VerticalOptions="Center">
                                    <Label Text="客厅分类"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#202020" />
                                    <Label Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                           Margin="0,10,0,0"
                                           FontSize="14"
                                           TextColor="#A8AFBA"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Right sub-card -->
                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 5"
                                Padding="20"
                                BackgroundColor="#F6F8FC"
                                Margin="0,10,5,0">
                            <Grid ColumnDefinitions="122,*">
                                <Border WidthRequest="122"
                                        HeightRequest="92"
                                        BackgroundColor="#E7EEF7"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Image Source="feature_category_right.png"
                                           Aspect="AspectFit" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0,0,0"
                                                     VerticalOptions="Center">
                                    <Label Text="客厅分类"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#202020" />
                                    <Label Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                           Margin="0,10,0,0"
                                           FontSize="14"
                                           TextColor="#A8AFBA"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Col 3: Right Feature Cards -->
                <Grid Grid.Column="3"
                      RowDefinitions="1*,1*"
                      Margin="0,0,0,20">

                    <!-- 3D Preview Card -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">
                        <Image Source="ellipse.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Opacity="0.6" />
                        <Image Source="home_3d_preview_bed.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <ImageButton Source="home_enter_button.png"
                                     Aspect="AspectFit"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     Margin="0,0,10,9"
                                     HeightRequest="50"
                                     BackgroundColor="Transparent"
                                     Command="{Binding NavigateTo3DShowcaseCommand}" />
                    </Grid>

                    <!-- VR Preview Card -->
                    <Grid Grid.Row="1">
                        <Image Source="home_vr_preview_room.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <ImageButton Source="home_enter_button.png"
                                     Aspect="AspectFit"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     Margin="0,0,10,9"
                                     HeightRequest="50"
                                     BackgroundColor="Transparent"
                                     Command="{Binding NavigateToPanoramaCommand}" />
                    </Grid>
                </Grid>

                <!-- Col 4: Right Spacer -->
            </Grid>

            <!-- Row 3: Bottom Buttons -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="0.063*,0.888*,0.006*,0.352*,0.066*">

                <!-- Left buttons: cart, my-orders, history-orders, qr-sync -->
                <Grid Grid.Column="1"
                      ColumnDefinitions="0.2*,0.03*,0.2*,0.03*,0.2*,0.03*,0.2*">
                    <ImageButton Grid.Column="0"
                                 Source="home_cart_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenCartCommand}" />
                    <ImageButton Grid.Column="2"
                                 Source="home_my_orders_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenMyOrdersCommand}" />
                    <ImageButton Grid.Column="4"
                                 Source="home_history_orders_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenHistoryOrdersCommand}" />
                    <ImageButton Grid.Column="6"
                                 Source="home_qr_sync_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding SyncQrCommand}" />
                </Grid>

                <!-- Right icon buttons: vr-library, effect-gallery, floorplan-library, ai-image -->
                <Grid Grid.Column="3"
                      ColumnDefinitions="0.25*,0.25*,0.25*,0.25*">
                    <ImageButton Grid.Column="0"
                                 Source="home_vr_library_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding NavigateToPanoramaCommand}" />
                    <ImageButton Grid.Column="1"
                                 Source="home_effect_gallery_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                    <ImageButton Grid.Column="2"
                                 Source="home_floorplan_library_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                    <ImageButton Grid.Column="3"
                                 Source="home_ai_image_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                </Grid>
            </Grid>

            <!-- Row 4: Bottom Spacer -->
        </Grid>
    </Grid>

</ContentPage>
