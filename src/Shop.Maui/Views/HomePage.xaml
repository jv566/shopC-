<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             xmlns:cvt="clr-namespace:Shop.Maui.Converters"
             x:Class="Shop.Maui.Views.HomePage"
             x:Name="PageRoot"
             Title="Shop"
             BackgroundColor="#0a1628"
             x:DataType="vm:HomePageViewModel">

    <ContentPage.Resources>
        <cvt:BannerDotConverter x:Key="BannerDotConverter" />
    </ContentPage.Resources>

    <Grid>
        <Image Source="home_page_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="0.147*,0.053*,0.604*,0.114*,0.082*">

            <Grid Grid.Row="0">
                <Image Source="home_title_logo.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       HeightRequest="80" />

                <Button Text="退出登录"
                        Command="{Binding LogoutCommand}"
                        WidthRequest="126"
                        HeightRequest="44"
                        Margin="0,18,30,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#80315F98"
                        BorderColor="#66D7ECFF"
                        BorderWidth="1"
                        CornerRadius="8" />
            </Grid>

            <Grid Grid.Row="2"
                  ColumnDefinitions="0.063*,0.317*,0.497*,0.312*,0.066*">

                <Grid Grid.Column="1"
                    x:Name="CategoryViewport"
                    SizeChanged="OnCategoryViewportSizeChanged">

                  <Grid x:Name="CategoryRoot"
                        WidthRequest="330"
                        HeightRequest="520"
                        Padding="6"
                        AnchorX="0"
                        AnchorY="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        RowDefinitions="1*,14,1*,14,1*,14,1*">

                        <!-- 第1行：床、沙发 -->
                        <Grid Grid.Row="0" ColumnDefinitions="1*,14,1*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="床"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_bed.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="bed|床" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="沙发"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_sofa.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="sofa|沙发" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 第2行：餐桌、斗柜 -->
                        <Grid Grid.Row="2" ColumnDefinitions="1*,14,1*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="餐桌"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_dining_table.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="23|餐桌" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="斗柜"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_sideboard.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="36|斗柜" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 第3行：书桌、床垫 -->
                        <Grid Grid.Row="4" ColumnDefinitions="1*,14,1*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="书桌"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_desk.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="58|书桌" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="床垫"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_mattress.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="09|床垫" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 第4行：茶几、书柜 -->
                        <Grid Grid.Row="6" ColumnDefinitions="1*,14,1*">

                            <Border Grid.Column="0"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="茶几"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_coffee_table.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="06|茶几" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    BackgroundColor="#663D78B8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Image Source="category_badge_background.png"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start" />

                                    <Label Text="书柜"
                                        Margin="18,5,0,0"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="White" />

                                    <Image Source="ellipse.png"
                                        HeightRequest="34"
                                        Opacity="0.55"
                                        HorizontalOptions="Center"
                                        VerticalOptions="End"
                                        Margin="0,0,0,10" />

                                    <ImageButton Source="home_bookcase.png"
                                                HeightRequest="78"
                                                WidthRequest="110"
                                                Aspect="AspectFit"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                BackgroundColor="Transparent"
                                                Padding="0"
                                                Command="{Binding NavigateToCategoryByIdCommand}"
                                                CommandParameter="39|书柜" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid Grid.Column="2"
                      RowDefinitions="0.7*,0.3*"
                      Margin="12,0,12,0">

                    <Border Grid.Row="0"
                            StrokeShape="RoundRectangle 10"
                            Margin="10,0,10,0">
                        <Grid>
                            <!-- 1. 当前轮播图图片 -->
                            <Image Source="{Binding CurrentBanner.ImagePath}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                             <!-- 2. 左切换按钮 -->
                            <Border BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    Margin="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PrevBannerCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#x276E;"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                             <!-- 2. 右切换按钮 -->
                            <Border BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NextBannerCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#x276F;"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                             <!-- 3. 轮播图指示器 -->
                            <Border HorizontalOptions="Center"
                                    VerticalOptions="End"
                                    Margin="0,0,0,14"
                                    BackgroundColor="#26FFFFFF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6">
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex" Converter="{StaticResource BannerDotConverter}" ConverterParameter="0" />
                                        </Border.BackgroundColor>
                                    </Border>
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex" Converter="{StaticResource BannerDotConverter}" ConverterParameter="1" />
                                        </Border.BackgroundColor>
                                    </Border>
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex" Converter="{StaticResource BannerDotConverter}" ConverterParameter="2" />
                                        </Border.BackgroundColor>
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,20,*"
                          Margin="0,6,0,0">

                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 5"
                                Padding="20"
                                BackgroundColor="#F6F8FC"
                                Margin="5,10,0,0">
                            <Grid ColumnDefinitions="122,*">
                                <Border WidthRequest="122"
                                        HeightRequest="92"
                                        BackgroundColor="#E7EEF7"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Image Source="feature_category_left.png"
                                           Aspect="AspectFit" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0,0,0"
                                                     VerticalOptions="Center">
                                    <Label Text="客厅分类"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#202020" />
                                    <Label Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                           Margin="0,10,0,0"
                                           FontSize="14"
                                           TextColor="#A8AFBA"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 5"
                                Padding="20"
                                BackgroundColor="#F6F8FC"
                                Margin="0,10,5,0">
                            <Grid ColumnDefinitions="122,*">
                                <Border WidthRequest="122"
                                        HeightRequest="92"
                                        BackgroundColor="#E7EEF7"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Image Source="feature_category_right.png"
                                           Aspect="AspectFit" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0,0,0"
                                                     VerticalOptions="Center">
                                    <Label Text="客厅分类"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#202020" />
                                    <Label Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                           Margin="0,10,0,0"
                                           FontSize="14"
                                           TextColor="#A8AFBA"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="3"
                      RowDefinitions="1*,1*"
                      Margin="0,0,0,20">

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">
                        <Image Source="ellipse.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Opacity="0.6" />
                        <Image Source="home_3d_preview_bed.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <ImageButton Source="home_enter_button.png"
                                     Aspect="AspectFit"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     Margin="0,0,10,9"
                                     HeightRequest="50"
                                     BackgroundColor="Transparent"
                                     Command="{Binding NavigateTo3DShowcaseCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Image Source="home_vr_preview_room.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <ImageButton Source="home_enter_button.png"
                                     Aspect="AspectFit"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     Margin="0,0,10,9"
                                     HeightRequest="50"
                                     BackgroundColor="Transparent"
                                     Command="{Binding NavigateToPanoramaCommand}" />
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="3"
                  ColumnDefinitions="0.063*,0.888*,0.006*,0.352*,0.066*">

                <Grid Grid.Column="1"
                      ColumnDefinitions="0.2*,0.03*,0.2*,0.03*,0.2*,0.03*,0.2*">
                    <ImageButton Grid.Column="0"
                                 Source="home_cart_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenCartCommand}" />
                    <ImageButton Grid.Column="2"
                                 Source="home_my_orders_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenMyOrdersCommand}" />
                    <ImageButton Grid.Column="4"
                                 Source="home_history_orders_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenHistoryOrdersCommand}" />
                    <ImageButton Grid.Column="6"
                                 Source="home_qr_sync_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding SyncQrCommand}" />
                </Grid>

                <Grid Grid.Column="3"
                      ColumnDefinitions="0.25*,0.25*,0.25*,0.25*">
                    <ImageButton Grid.Column="0"
                                 Source="home_vr_library_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding NavigateToPanoramaCommand}" />
                    <ImageButton Grid.Column="1"
                                 Source="home_effect_gallery_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                    <ImageButton Grid.Column="2"
                                 Source="home_floorplan_library_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                    <ImageButton Grid.Column="3"
                                 Source="home_ai_image_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
