<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             xmlns:cvt="clr-namespace:Shop.Maui.Converters"
             x:Class="Shop.Maui.Views.HomePage"
             x:Name="PageRoot"
             Title="Shop"
             BackgroundColor="#0a1628"
             x:DataType="vm:HomePageViewModel">

    <ContentPage.Resources>
        <cvt:BannerDotConverter x:Key="BannerDotConverter" />
    </ContentPage.Resources>

    <Grid>
        <Image Source="home_page_background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <Grid RowDefinitions="0.147*,0.053*,0.604*,0.114*,0.082*">

            <!-- 顶部标题和退出登录 -->
            <Grid Grid.Row="0">
                <Image Source="home_title_logo.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       HeightRequest="80" />

                <Button Text="退出登录"
                        Command="{Binding LogoutCommand}"
                        WidthRequest="126"
                        HeightRequest="44"
                        Margin="0,18,30,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#80315F98"
                        BorderColor="#66D7ECFF"
                        BorderWidth="1"
                        CornerRadius="8" />
            </Grid>

            <!-- 主体区域 -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="0.063*,0.317*,0.497*,0.312*,0.066*">

                <!-- 左侧 8 个商品分类 -->
                <!-- 这个区域本身不缩放，只负责对准背景图里的 8 个黑框 -->
                <Grid Grid.Column="1"
                      x:Name="CategoryViewport"
                      SizeChanged="OnCategoryViewportSizeChanged"
                      Margin="0,-8,0,12"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      RowDefinitions="1*,18,1*,18,1*,18,1*"
                      ColumnDefinitions="1*,18,1*">

                    <!-- 第1格：床 -->
                    <Grid x:Name="BedSlot"
                          Grid.Row="0"
                          Grid.Column="0"
                          >
                        <Grid x:Name="BedContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              
                               >

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start" 
                                   VerticalOptions="Start"    
                                   />

                            <Label Text="床"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_bed.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="bed|床" />
                        </Grid>
                    </Grid>

                    <!-- 第2格：沙发 -->
                    <Grid x:Name="SofaSlot"
                          Grid.Row="0"
                          Grid.Column="2"
                          >
                        <Grid x:Name="SofaContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="沙发"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_sofa.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="sofa|沙发" />
                        </Grid>
                    </Grid>

                    <!-- 第3格：餐桌 -->
                    <Grid x:Name="DiningTableSlot"
                          Grid.Row="2"
                          Grid.Column="0"
                          >
                        <Grid x:Name="DiningTableContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="餐桌"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_dining_table.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="23|餐桌" />
                        </Grid>
                    </Grid>

                    <!-- 第4格：斗柜 -->
                    <Grid x:Name="SideboardSlot"
                          Grid.Row="2"
                          Grid.Column="2"
                          >
                        <Grid x:Name="SideboardContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="斗柜"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_sideboard.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="36|斗柜" />
                        </Grid>
                    </Grid>

                    <!-- 第5格：书桌 -->
                    <Grid x:Name="DeskSlot"
                          Grid.Row="4"
                          Grid.Column="0"
                          >
                        <Grid x:Name="DeskContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="书桌"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_desk.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="58|书桌" />
                        </Grid>
                    </Grid>

                    <!-- 第6格：床垫 -->
                    <Grid x:Name="MattressSlot"
                          Grid.Row="4"
                          Grid.Column="2"
                          >
                        <Grid x:Name="MattressContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="床垫"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_mattress.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="09|床垫" />
                        </Grid>
                    </Grid>

                    <!-- 第7格：茶几 -->
                    <Grid x:Name="CoffeeTableSlot"
                          Grid.Row="6"
                          Grid.Column="0"
                          >
                        <Grid x:Name="CoffeeTableContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="茶几"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_coffee_table.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="06|茶几" />
                        </Grid>
                    </Grid>

                    <!-- 第8格：书柜 -->
                    <Grid x:Name="BookcaseSlot"
                          Grid.Row="6"
                          Grid.Column="2"
                          >
                        <Grid x:Name="BookcaseContent"
                              WidthRequest="180"
                              HeightRequest="130"
                              AnchorX="0.5"
                              AnchorY="0.5"
                              HorizontalOptions="Center"
                              VerticalOptions="Center">

                            <Image Source="category_badge_background.png"
                                   HeightRequest="34"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start" />

                            <Label Text="书柜"
                                   Margin="16,5,0,0"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="White" />

                            <Image Source="ellipse.png"
                                   HeightRequest="34"
                                   Opacity="0.55"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,8" />

                            <ImageButton Source="home_bookcase.png"
                                         HeightRequest="82"
                                         WidthRequest="120"
                                         Aspect="AspectFit"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         BackgroundColor="Transparent"
                                         Padding="0"
                                         Command="{Binding NavigateToCategoryByIdCommand}"
                                         CommandParameter="39|书柜" />
                        </Grid>
                    </Grid>

                </Grid>

                <!-- 中间轮播图和下面两个分类卡片 -->
                <Grid Grid.Column="2"
                      RowDefinitions="0.7*,0.3*"
                      Margin="12,0,12,0">

                    <Border Grid.Row="0"
                            StrokeShape="RoundRectangle 10"
                            Margin="10,0,10,0">
                        <Grid>
                            <Image Source="{Binding CurrentBanner.ImagePath}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />

                            <Border BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center"
                                    Margin="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PrevBannerCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#x276E;"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Border BackgroundColor="#80000000"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NextBannerCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="&#x276F;"
                                       FontSize="20"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Border HorizontalOptions="Center"
                                    VerticalOptions="End"
                                    Margin="0,0,0,14"
                                    BackgroundColor="#26FFFFFF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,6">
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex"
                                                     Converter="{StaticResource BannerDotConverter}"
                                                     ConverterParameter="0" />
                                        </Border.BackgroundColor>
                                    </Border>

                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex"
                                                     Converter="{StaticResource BannerDotConverter}"
                                                     ConverterParameter="1" />
                                        </Border.BackgroundColor>
                                    </Border>

                                    <Border WidthRequest="8"
                                            HeightRequest="8"
                                            StrokeShape="RoundRectangle 4"
                                            StrokeThickness="0">
                                        <Border.BackgroundColor>
                                            <Binding Path="CurrentBannerIndex"
                                                     Converter="{StaticResource BannerDotConverter}"
                                                     ConverterParameter="2" />
                                        </Border.BackgroundColor>
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,20,*"
                          Margin="0,6,0,0">

                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 5"
                                Padding="20"
                                BackgroundColor="#F6F8FC"
                                Margin="5,10,0,0">
                            <Grid ColumnDefinitions="122,*">
                                <Border WidthRequest="122"
                                        HeightRequest="92"
                                        BackgroundColor="#E7EEF7"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Image Source="feature_category_left.png"
                                           Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0,0,0"
                                                     VerticalOptions="Center">
                                    <Label Text="客厅分类"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#202020" />

                                    <Label Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                           Margin="0,10,0,0"
                                           FontSize="14"
                                           TextColor="#A8AFBA"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 5"
                                Padding="20"
                                BackgroundColor="#F6F8FC"
                                Margin="0,10,5,0">
                            <Grid ColumnDefinitions="122,*">
                                <Border WidthRequest="122"
                                        HeightRequest="92"
                                        BackgroundColor="#E7EEF7"
                                        StrokeShape="RoundRectangle 8"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center">
                                    <Image Source="feature_category_right.png"
                                           Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Margin="14,0,0,0"
                                                     VerticalOptions="Center">
                                    <Label Text="客厅分类"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#202020" />

                                    <Label Text="分类介绍xxxxxxx&#x0a;xxxxxxx"
                                           Margin="0,10,0,0"
                                           FontSize="14"
                                           TextColor="#A8AFBA"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 右侧 3D 和 VR 预览 -->
                <Grid Grid.Column="3"
                      RowDefinitions="1*,1*"
                      Margin="0,0,0,20">

                    <Grid Grid.Row="0"
                          Margin="0,0,0,12">
                        <Image Source="ellipse.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Opacity="0.6" />

                        <Image Source="home_3d_preview_bed.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <ImageButton Source="home_enter_button.png"
                                     Aspect="AspectFit"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     Margin="0,0,10,9"
                                     HeightRequest="50"
                                     BackgroundColor="Transparent"
                                     Command="{Binding NavigateTo3DShowcaseCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Image Source="home_vr_preview_room.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <ImageButton Source="home_enter_button.png"
                                     Aspect="AspectFit"
                                     HorizontalOptions="End"
                                     VerticalOptions="End"
                                     Margin="0,0,10,9"
                                     HeightRequest="50"
                                     BackgroundColor="Transparent"
                                     Command="{Binding NavigateToPanoramaCommand}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- 底部按钮区域 -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="0.063*,0.888*,0.006*,0.352*,0.066*">

                <Grid Grid.Column="1"
                      ColumnDefinitions="0.2*,0.03*,0.2*,0.03*,0.2*,0.03*,0.2*">

                    <ImageButton Grid.Column="0"
                                 Source="home_cart_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenCartCommand}" />

                    <ImageButton Grid.Column="2"
                                 Source="home_my_orders_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenMyOrdersCommand}" />

                    <ImageButton Grid.Column="4"
                                 Source="home_history_orders_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding OpenHistoryOrdersCommand}" />

                    <ImageButton Grid.Column="6"
                                 Source="home_qr_sync_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding SyncQrCommand}" />
                </Grid>

                <Grid Grid.Column="3"
                      ColumnDefinitions="0.25*,0.25*,0.25*,0.25*">

                    <ImageButton Grid.Column="0"
                                 Source="home_vr_library_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent"
                                 Command="{Binding NavigateToPanoramaCommand}" />

                    <ImageButton Grid.Column="1"
                                 Source="home_effect_gallery_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />

                    <ImageButton Grid.Column="2"
                                 Source="home_floorplan_library_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />

                    <ImageButton Grid.Column="3"
                                 Source="home_ai_image_button.png"
                                 Aspect="AspectFit"
                                 HorizontalOptions="Center"
                                 VerticalOptions="End"
                                 BackgroundColor="Transparent" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>