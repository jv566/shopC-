<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.HomePage"
             Title="Shop"
             x:DataType="vm:HomePageViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Banner Carousel -->
            <Border Stroke="#E0E0E0"
                    StrokeShape="RoundRectangle 12"
                    Padding="0"
                    HeightRequest="180">
                <Grid>
                    <Image Source="{Binding CurrentBanner.ImagePath}"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                    <Label Text="{Binding CurrentBanner.Title}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="White"
                           BackgroundColor="#80000000"
                           Padding="12,6"
                           VerticalOptions="End"
                           HorizontalOptions="Start"
                           Margin="12" />
                </Grid>
            </Border>

            <Label Text="{Binding BannerIndexText}"
                   HorizontalOptions="Center"
                   FontSize="12"
                   TextColor="Gray" />

            <!-- Category Grid -->
            <Label Text="商品分类"
                   FontAttributes="Bold"
                   FontSize="16" />

            <CollectionView ItemsSource="{Binding Categories}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="3"
                                     VerticalItemSpacing="12"
                                     HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ProductCategoryOption">
                        <Border Stroke="#E0E0E0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                BackgroundColor="White">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomePageViewModel}}, Path=NavigateToProductListCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding DisplayName}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="14" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Quick Actions -->
            <Label Text="快捷功能"
                   FontAttributes="Bold"
                   FontSize="16" />

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="VR 全景"
                        Command="{Binding NavigateToPanoramaCommand}" />
                <Button Grid.Column="1"
                        Text="3D 展示"
                        Command="{Binding NavigateTo3DShowcaseCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
