<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.Image2CategoryPage"
             x:Name="PageRoot"
             x:DataType="vm:ProductListViewModel"
             Title="分类展示"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#071629">

    <Grid x:Name="Viewport"
        
          SizeChanged="OnViewportSizeChanged">

        <Grid x:Name="DesignRoot"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              WidthRequest="1920"
              HeightRequest="1080"
              AnchorX="0"
              AnchorY="0">

            <Image Source="Assets/Images/首页2=2 1.png"
                   Aspect="Fill" />



            <AbsoluteLayout WidthRequest="1920"
                            HeightRequest="1080">

                <Button AbsoluteLayout.LayoutBounds="24,24,132,52"
                        AbsoluteLayout.LayoutFlags="None"
                        Text="&#x2190; &#x8FD4;&#x56DE;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#315F98"
                        BorderColor="#18F7FF"
                        BorderWidth="1"
                        CornerRadius="8"
                        Clicked="OnBackClicked" />

                <!-- 左侧菜单区 -->
                <Grid AbsoluteLayout.LayoutBounds="117,96,369,890"
                      AbsoluteLayout.LayoutFlags="None">
                      
                    <Image Source="menu_panel.png"
                           Aspect="Fill" />

                    <Grid Padding="18,26,18,34">

                        <!-- 去 ViewModel 里找 PrimaryMenus 这个集合
                            然后把集合里的每一项显示出来，不要默认的选中效果，不要滚动条 -->
                        <CollectionView ItemsSource="{Binding PrimaryMenus}"
                                        SelectionMode="None"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="16" />
                            </CollectionView.ItemsLayout>


                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ProductListPrimaryMenuItem">

                                    <VerticalStackLayout Spacing="0">
                                        <Grid HeightRequest="82">
                                            
                                            <Border BackgroundColor="{Binding BackgroundColor}"
                                                    Stroke="{Binding StrokeColor}"
                                                    StrokeThickness="1.5"
                                                    StrokeShape="RoundRectangle 8">
                                                <Border.Shadow>
                                                    <Shadow Brush="#020B1B"
                                                            Offset="0,4"
                                                            Radius="10"
                                                            Opacity="0.18" />
                                                </Border.Shadow>

                                                <Grid Padding="0"
                                                      ColumnDefinitions="6,86,*">
                                                    <Border Grid.Column="0"
                                                            StrokeThickness="0"
                                                            BackgroundColor="#18F7FF"
                                                            Opacity="0.82" />

                                                    <Image Grid.Column="1"
                                                           Source="{Binding IconSource}"
                                                           WidthRequest="54"
                                                           HeightRequest="44"
                                                           Aspect="AspectFit"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />

                                                    <Label Grid.Column="2"
                                                           Margin="0,0,18,0"
                                                           Text="{Binding DisplayName}"
                                                           TextColor="{Binding TextColor}"
                                                           FontSize="30"
                                                           FontAttributes="Bold"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectPrimaryCategoryCommand}"
                                                    CommandParameter="{Binding Group.PrimaryCategory}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <CollectionView ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SecondaryMenus}"
                                                        IsVisible="{Binding IsSelected}"
                                                        SelectionMode="None"
                                                        VerticalScrollBarVisibility="Never"
                                                        Margin="0,6,0,0">

                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical"
                                                                   ItemSpacing="0" />
                                            </CollectionView.ItemsLayout>

                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="m:ProductListSecondaryMenuItem">
                                                    <Grid RowDefinitions="42,8"
                                                          Padding="48,0">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectSecondaryCategoryCommand}"
                                                                CommandParameter="{Binding Category}" />
                                                        </Grid.GestureRecognizers>

                                                        <Label Grid.Row="0"
                                                               Text="{Binding DisplayName}"
                                                               TextColor="{Binding TextColor}"
                                                               FontSize="28"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center" />

                                                        <Image Grid.Row="1"
                                                               Source="menu_divider.png"
                                                               Aspect="Fill"
                                                               Opacity="0.75" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>
                    <!-- 右边商品卡片 -->
                <CollectionView AbsoluteLayout.LayoutBounds="516,96,1324,890"
                                AbsoluteLayout.LayoutFlags="None"
                                ItemsSource="{Binding DisplayProducts}"
                                ItemSizingStrategy="MeasureFirstItem"
                                SelectionMode="None"
                                Margin="0"
                                VerticalScrollBarVisibility="Never"
                                HorizontalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="10"
                                         VerticalItemSpacing="30" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:ProductListDisplayItem">
                            <Grid WidthRequest="408"
                                  HeightRequest="430"
                                  Padding="0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectProductCommand}"
                                        CommandParameter="{Binding Product}" />
                                </Grid.GestureRecognizers>

                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">
                                    <Border.Shadow>
                                        <Shadow Brush="#020B1B"
                                                Offset="0,8"
                                                Radius="18"
                                                Opacity="0.28" />
                                    </Border.Shadow>

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#4D7FB9"
                                                          Offset="0.00" />
                                            <GradientStop Color="#315F98"
                                                          Offset="0.58" />
                                            <GradientStop Color="#24456F"
                                                          Offset="1.00" />
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid Padding="20"
                                          RowDefinitions="320,*"
                                          RowSpacing="10">
                                        <Border Grid.Row="0"
                                                WidthRequest="366"
                                                HeightRequest="320"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Start">
                                            <Image Source="{Binding ImageSource}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="366"
                                                   HeightRequest="320"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />
                                        </Border>
                                        <!-- 商品型号和价格 -->
                                        <AbsoluteLayout Grid.Row="1"
                                                        Margin="8,0,8,0"
                                                        HeightRequest="56"
                                                        VerticalOptions="Start">
                                            <Label AbsoluteLayout.LayoutBounds="0,0,220,56"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="{Binding DisplayModelText}"
                                                   TextColor="White"
                                                   FontSize="28"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   VerticalTextAlignment="Center" />

                                            <Label AbsoluteLayout.LayoutBounds="222,0,136,56"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="{Binding DisplayPriceText}"
                                                   TextColor="#18F7FF"
                                                   FontSize="30"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalTextAlignment="End"
                                                   VerticalTextAlignment="Center" />
                                        </AbsoluteLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </AbsoluteLayout>
        </Grid>
    </Grid>
</ContentPage>
