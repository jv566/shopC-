<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.Image2CategoryPage"
             x:Name="PageRoot"
             x:DataType="vm:ProductListViewModel"
             Title="分类展示"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#071629">

    <Grid x:Name="Viewport"
          SizeChanged="OnViewportSizeChanged">
        <Grid x:Name="DesignRoot"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              WidthRequest="1920"
              HeightRequest="1080"
              AnchorX="0"
              AnchorY="0">

            <Image Source="Assets/Images/首页2=2 1.png"
                   Aspect="Fill" />

            <AbsoluteLayout WidthRequest="1920"
                            HeightRequest="1080">

                <Grid AbsoluteLayout.LayoutBounds="117,96,369,890"
                      AbsoluteLayout.LayoutFlags="None">
                    <Image Source="menu_panel.png"
                           Aspect="Fill" />

                    <Grid Padding="20,34,20,54">
                        <CollectionView ItemsSource="{Binding PrimaryMenus}"
                                        SelectionMode="None"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical"
                                                   ItemSpacing="30" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ProductListPrimaryMenuItem">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid HeightRequest="100">
                                            <Image Source="{Binding BackgroundImageSource}"
                                                   Aspect="Fill"
                                                   Opacity="0.92" />

                                            <Grid Padding="28,0"
                                                  ColumnDefinitions="112,*">
                                                <Image Grid.Column="0"
                                                       Source="{Binding IconSource}"
                                                       WidthRequest="75"
                                                       HeightRequest="60"
                                                       Aspect="AspectFit"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />

                                                <Label Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       TextColor="{Binding TextColor}"
                                                       FontSize="34"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>

                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectPrimaryCategoryCommand}"
                                                    CommandParameter="{Binding Group.PrimaryCategory}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <CollectionView ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SecondaryMenus}"
                                                        IsVisible="{Binding IsSelected}"
                                                        SelectionMode="None"
                                                        VerticalScrollBarVisibility="Never"
                                                        Margin="0,10,0,0">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical"
                                                                   ItemSpacing="0" />
                                            </CollectionView.ItemsLayout>

                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="m:ProductListSecondaryMenuItem">
                                                    <Grid RowDefinitions="50,10"
                                                          Padding="42,0">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectSecondaryCategoryCommand}"
                                                                CommandParameter="{Binding Category}" />
                                                        </Grid.GestureRecognizers>

                                                        <Label Grid.Row="0"
                                                               Text="{Binding DisplayName}"
                                                               TextColor="{Binding TextColor}"
                                                               FontSize="34"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center" />

                                                        <Image Grid.Row="1"
                                                               Source="menu_divider.png"
                                                               Aspect="Fill"
                                                               Opacity="0.75" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <CollectionView AbsoluteLayout.LayoutBounds="516,96,1324,890"
                                AbsoluteLayout.LayoutFlags="None"
                                ItemsSource="{Binding DisplayProducts}"
                                ItemSizingStrategy="MeasureFirstItem"
                                SelectionMode="None"
                                Margin="0"
                                VerticalScrollBarVisibility="Never"
                                HorizontalScrollBarVisibility="Never">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="30"
                                         VerticalItemSpacing="30" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:ProductListDisplayItem">
                            <Grid WidthRequest="408"
                                  HeightRequest="430"
                                  Padding="0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectProductCommand}"
                                        CommandParameter="{Binding Product}" />
                                </Grid.GestureRecognizers>

                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8">
                                    <Border.Shadow>
                                        <Shadow Brush="#020B1B"
                                                Offset="0,8"
                                                Radius="18"
                                                Opacity="0.28" />
                                    </Border.Shadow>

                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="0,1">
                                            <GradientStop Color="#4D7FB9"
                                                          Offset="0.00" />
                                            <GradientStop Color="#315F98"
                                                          Offset="0.58" />
                                            <GradientStop Color="#24456F"
                                                          Offset="1.00" />
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <Grid Padding="20"
                                          RowDefinitions="320,*"
                                          RowSpacing="10">
                                        <Border Grid.Row="0"
                                                WidthRequest="366"
                                                HeightRequest="320"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Start">
                                            <Image Source="{Binding ImageSource}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="366"
                                                   HeightRequest="320"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill" />
                                        </Border>

                                        <AbsoluteLayout Grid.Row="1"
                                                        Margin="8,0,8,0"
                                                        HeightRequest="56"
                                                        VerticalOptions="Start">
                                            <Label AbsoluteLayout.LayoutBounds="0,0,220,56"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="{Binding DisplayModelText}"
                                                   TextColor="White"
                                                   FontSize="28"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   VerticalTextAlignment="Center" />

                                            <Label AbsoluteLayout.LayoutBounds="222,0,136,56"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="{Binding DisplayPriceText}"
                                                   TextColor="#18F7FF"
                                                   FontSize="30"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HorizontalTextAlignment="End"
                                                   VerticalTextAlignment="Center" />
                                        </AbsoluteLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </AbsoluteLayout>
        </Grid>
    </Grid>
</ContentPage>
