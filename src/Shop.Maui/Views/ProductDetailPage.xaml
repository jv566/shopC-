<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.ProductDetailPage"
             x:Name="PageRoot"
             Title="商品详情"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#071629"
             x:DataType="vm:ProductDetailViewModel">

    <Grid x:Name="Viewport"
          SizeChanged="OnViewportSizeChanged">
        <Grid x:Name="DesignRoot"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              WidthRequest="1920"
              HeightRequest="1080"
              AnchorX="0"
              AnchorY="0">

            <Image Source="Assets/Images/首页2=2 1.png"
                   Aspect="Fill" />

            <AbsoluteLayout WidthRequest="1920"
                            HeightRequest="1080">

                <Button AbsoluteLayout.LayoutBounds="24,24,132,52"
                        AbsoluteLayout.LayoutFlags="None"
                        Text="&#x2190; &#x8FD4;&#x56DE;"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#315F98"
                        BorderColor="#18F7FF"
                        BorderWidth="1"
                        CornerRadius="8"
                        Clicked="OnBackClicked" />

                <Border AbsoluteLayout.LayoutBounds="116,86,1688,906"
                        AbsoluteLayout.LayoutFlags="None"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Border.Shadow>
                        <Shadow Brush="#020B1B"
                                Offset="0,10"
                                Radius="22"
                                Opacity="0.36" />
                    </Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">
                            <GradientStop Color="#4D7FB9"
                                          Offset="0.00" />
                            <GradientStop Color="#315F98"
                                          Offset="0.56" />
                            <GradientStop Color="#24456F"
                                          Offset="1.00" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Padding="34"
                          ColumnDefinitions="760,*"
                          ColumnSpacing="44">

                        <Border Grid.Column="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#EAF4FF">
                            <Grid>
                                <Image Source="{Binding ProductImageSource}"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />

                                <Border HeightRequest="132"
                                        Padding="28,0"
                                        VerticalOptions="End"
                                        BackgroundColor="#B0071629"
                                        StrokeThickness="0">
                                    <Grid RowDefinitions="*,*"
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="2"
                                          ColumnSpacing="24">
                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding ProductModelText}"
                                               TextColor="White"
                                               FontSize="30"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding ProductCodeText}"
                                               TextColor="#D7ECFF"
                                               FontSize="24"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="1"
                                               Grid.Column="0"
                                               Text="{Binding ProductPriceText}"
                                               TextColor="#18F7FF"
                                               FontSize="36"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding ProductOriginalPriceText}"
                                               TextColor="#B8D6F5"
                                               FontSize="24"
                                               TextDecorations="Strikethrough"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1"
                              RowDefinitions="Auto,Auto,*,Auto"
                              RowSpacing="28">

                            <Grid Grid.Row="0"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="18">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="鍟嗗搧绫诲瀷閫夋嫨"
                                           TextColor="White"
                                           FontSize="28"
                                           FontAttributes="Bold" />

                                    <Label Grid.Column="1"
                                           Text="{Binding SelectedOptionText}"
                                           TextColor="#B8D6F5"
                                           FontSize="22"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           VerticalTextAlignment="Center" />
                                </Grid>

                                <VerticalStackLayout Grid.Row="1"
                                                     Spacing="14"
                                                     BindableLayout.ItemsSource="{Binding SpecOptionGroups}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="m:ProductSpecOptionGroup">
                                            <Grid ColumnDefinitions="112,*"
                                                  ColumnSpacing="18"
                                                  HeightRequest="58">
                                                <Label Grid.Column="0"
                                                       Text="{Binding SpecName}"
                                                       TextColor="#D7ECFF"
                                                       FontSize="23"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"
                                                       VerticalTextAlignment="Center" />

                                                <ScrollView Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalScrollBarVisibility="Never">
                                                    <HorizontalStackLayout Spacing="14"
                                                                           BindableLayout.ItemsSource="{Binding Options}">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="m:ProductColorImageOption">
                                                                <Border WidthRequest="172"
                                                                        HeightRequest="58"
                                                                        Stroke="#18F7FF"
                                                                        StrokeThickness="{Binding ButtonBorderWidth}"
                                                                        StrokeShape="RoundRectangle 8"
                                                                        BackgroundColor="{Binding ButtonBackgroundColor}">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectColorCommand}"
                                                                                              CommandParameter="{Binding Index}" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding OptionName}"
                                                                           FontSize="20"
                                                                           FontAttributes="Bold"
                                                                           TextColor="#0B2442"
                                                                           HorizontalTextAlignment="Center"
                                                                           VerticalTextAlignment="Center"
                                                                           LineBreakMode="TailTruncation"
                                                                           MaxLines="1" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </HorizontalStackLayout>
                                                </ScrollView>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </Grid>

                            <Border Grid.Row="1"
                                    HeightRequest="1"
                                    BackgroundColor="#55B8D6F5"
                                    StrokeThickness="0" />

                            <ScrollView Grid.Row="2"
                                        Orientation="Vertical"
                                        Padding="0,0,10,0"
                                        HorizontalScrollBarVisibility="Never"
                                        VerticalScrollBarVisibility="Always">
                                <Grid RowDefinitions="Auto"
                                      RowSpacing="18">
                                    <Grid Grid.Row="0"
                                          IsVisible="False"
                                          ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="商品类型选择"
                                               TextColor="White"
                                               FontSize="28"
                                               FontAttributes="Bold" />

                                        <Label Grid.Column="1"
                                               Text="{Binding SelectedOptionText}"
                                               TextColor="#B8D6F5"
                                               FontSize="22"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               VerticalTextAlignment="Center" />
                                    </Grid>

                                    <VerticalStackLayout Grid.Row="0"
                                                         IsVisible="False"
                                                         Spacing="14"
                                                         BindableLayout.ItemsSource="{Binding SpecOptionGroups}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="m:ProductSpecOptionGroup">
                                                <Grid ColumnDefinitions="112,*"
                                                      ColumnSpacing="18"
                                                      HeightRequest="58">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding SpecName}"
                                                           TextColor="#D7ECFF"
                                                           FontSize="23"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"
                                                           VerticalTextAlignment="Center" />

                                                    <ScrollView Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                HorizontalScrollBarVisibility="Never">
                                                        <HorizontalStackLayout Spacing="14"
                                                                               BindableLayout.ItemsSource="{Binding Options}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="m:ProductColorImageOption">
                                                                    <Border WidthRequest="172"
                                                                            HeightRequest="58"
                                                                            Stroke="#18F7FF"
                                                                            StrokeThickness="{Binding ButtonBorderWidth}"
                                                                            StrokeShape="RoundRectangle 8"
                                                                            BackgroundColor="{Binding ButtonBackgroundColor}">
                                                                        <Border.GestureRecognizers>
                                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectColorCommand}"
                                                                                                  CommandParameter="{Binding Index}" />
                                                                        </Border.GestureRecognizers>
                                                                        <Label Text="{Binding OptionName}"
                                                                               FontSize="20"
                                                                               FontAttributes="Bold"
                                                                               TextColor="#0B2442"
                                                                               HorizontalTextAlignment="Center"
                                                                               VerticalTextAlignment="Center"
                                                                               LineBreakMode="TailTruncation"
                                                                               MaxLines="1" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </ScrollView>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Border Grid.Row="0"
                                            IsVisible="False"
                                            Margin="0,0,0,8"
                                            Padding="26"
                                            Stroke="#3B73AA"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#66132642">
                                        <Grid RowDefinitions="Auto,Auto,Auto"
                                              ColumnDefinitions="128,*"
                                              RowSpacing="18"
                                              ColumnSpacing="22">
                                            <Label Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="编号"
                                                   TextColor="#B8D6F5"
                                                   FontSize="24" />
                                            <Label Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding ProductCodeText}"
                                                   TextColor="White"
                                                   FontSize="24"
                                                   FontAttributes="Bold" />

                                            <Label Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="型号"
                                                   TextColor="#B8D6F5"
                                                   FontSize="24" />
                                            <Label Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding ProductModelText}"
                                                   TextColor="White"
                                                   FontSize="24"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />

                                            <Label Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="价格"
                                                   TextColor="#B8D6F5"
                                                   FontSize="24" />
                                            <Label Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding ProductPriceText}"
                                                   TextColor="#18F7FF"
                                                   FontSize="24"
                                                   FontAttributes="Bold" />

                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="0"
                                            Margin="0,0,0,8"
                                            Padding="0"
                                            Stroke="#3B73AA"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#66132642">
                                        <Grid RowDefinitions="64,*">
                                            <Grid Grid.Row="0"
                                                  Padding="26,0"
                                                  ColumnDefinitions="*,Auto"
                                                  BackgroundColor="#3318F7FF">
                                                <Label Grid.Column="0"
                                                       Text="介绍"
                                                       TextColor="White"
                                                       FontSize="26"
                                                       FontAttributes="Bold"
                                                       VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1"
                                                       Text="商品详情"
                                                       TextColor="#B8D6F5"
                                                       FontSize="22"
                                                       VerticalTextAlignment="Center" />
                                            </Grid>

                                            <WebView Grid.Row="1"
                                                     HeightRequest="460"
                                                     BackgroundColor="#102947"
                                                     Source="{Binding ProductDescriptionSource}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollView>

                            <Grid Grid.Row="3"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="18">
                                <Button Grid.Column="0"
                                        Text="加入购物车"
                                        BackgroundColor="#18A5FF"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="26"
                                        CornerRadius="8"
                                        HeightRequest="70"
                                        Command="{Binding AddToCartCommand}" />
                                <Button Grid.Column="1"
                                        Text="立即购买"
                                        BackgroundColor="#18F7FF"
                                        TextColor="#071629"
                                        FontAttributes="Bold"
                                        FontSize="26"
                                        CornerRadius="8"
                                        HeightRequest="70"
                                        Command="{Binding BuyNowCommand}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </AbsoluteLayout>
        </Grid>
    </Grid>
</ContentPage>
