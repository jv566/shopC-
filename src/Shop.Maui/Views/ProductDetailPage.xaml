<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.ProductDetailPage"
             Title="商品详情"
             BackgroundColor="#f5f5f5"
             x:DataType="vm:ProductDetailViewModel">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Product Image Header -->
            <Grid HeightRequest="300">
                <Image Source="sofa_preview.png"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />
                <Border Padding="20,16"
                        VerticalOptions="End"
                        BackgroundColor="#80000000">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding ProductModelText}"
                               FontAttributes="Bold"
                               FontSize="22"
                               TextColor="White" />
                        <Label Text="{Binding ProductPriceText}"
                               TextColor="#FFD700"
                               FontSize="20"
                               FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Content Card -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Margin="0,-20,0,0"
                    Padding="20,24">

                <VerticalStackLayout Spacing="20">

                    <!-- Color Selection -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="颜色选择"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#333" />
                            <Label Grid.Column="1"
                                   Text="{Binding ColorIndexText}"
                                   FontSize="14"
                                   TextColor="#999"
                                   VerticalOptions="Center" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding ColorOptions}"
                                        SelectionMode="None"
                                        HeightRequest="52">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal"
                                                   ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:ProductColorImageOption">
                                    <Border Padding="14,10"
                                            Stroke="#2196F3"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{Binding ButtonBackgroundColor}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductDetailViewModel}}, Path=SelectColorCommand}"
                                                                  CommandParameter="{Binding Index}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding ColorName}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#333"
                                               VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <Border HeightRequest="1"
                            BackgroundColor="#e0e0e0"
                            StrokeThickness="0" />

                    <!-- Product Info -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="商品信息"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="#333" />

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="10"
                              ColumnSpacing="12">
                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Text="型号"
                                   FontSize="14"
                                   TextColor="#666" />
                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding ProductModelText}"
                                   FontSize="14"
                                   TextColor="#333"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Text="价格"
                                   FontSize="14"
                                   TextColor="#666" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding ProductPriceText}"
                                   FontSize="14"
                                   TextColor="#E53935"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="2"
                                   Grid.Column="0"
                                   Text="编号"
                                   FontSize="14"
                                   TextColor="#666" />
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Text="{Binding Product.Id}"
                                   FontSize="14"
                                   TextColor="#333" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Divider -->
                    <Border HeightRequest="1"
                            BackgroundColor="#e0e0e0"
                            StrokeThickness="0" />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="加入购物车"
                                BackgroundColor="#FF9800"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="12"
                                HeightRequest="52"
                                Command="{Binding AddToCartCommand}" />
                        <Button Grid.Column="1"
                                Text="立即购买"
                                BackgroundColor="#E53935"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15"
                                CornerRadius="12"
                                HeightRequest="52"
                                Command="{Binding BuyNowCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
