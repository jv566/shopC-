<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.ProductListPage"
             Title="商品列表"
             BackgroundColor="#f5f5f5"
             x:DataType="vm:ProductListViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="#1a1a2e"
                Padding="16,12"
                StrokeThickness="0">
            <Label Text="{Binding CurrentCategoryText}"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="White" />
        </Border>

        <!-- Category Tabs -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding CategoryTree}"
                        SelectionMode="None"
                        HeightRequest="64"
                        BackgroundColor="White">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:ProductCategoryGroup">
                    <Border Padding="12,8"
                            Stroke="#e0e0e0"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="White"
                            Margin="4,8,4,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=SelectPrimaryCategoryCommand}"
                                                  CommandParameter="{Binding PrimaryCategory}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding PrimaryCategory.DisplayName}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333"
                               VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Product Grid -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None"
                        Margin="12,8,12,12">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 VerticalItemSpacing="12"
                                 HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:ProductListItem">
                    <Border Stroke="#e0e0e0"
                            StrokeShape="RoundRectangle 16"
                            Padding="0"
                            BackgroundColor="White">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=SelectProductCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="0">
                            <Grid HeightRequest="140">
                                <Image Source="sofa_preview.png"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                                <Border Background="#80000000"
                                        Padding="8,4"
                                        VerticalOptions="End"
                                        HorizontalOptions="Start"
                                        Margin="8,8"
                                        StrokeShape="RoundRectangle 8">
                                    <Label Text="{Binding CategoryId}"
                                           FontSize="11"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Padding="12,10"
                                                 Spacing="6">
                                <Label Text="{Binding ModelName}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="#333" />
                                <Label Text="{Binding SalePrice, StringFormat='￥{0:F2}'}"
                                       TextColor="#E53935"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
