<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             xmlns:m="clr-namespace:Shop.Maui.Models"
             x:Class="Shop.Maui.Views.MyOrdersPage"
             x:Name="PageRoot"
             Title="我的订单"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#071629"
             x:DataType="vm:MyOrdersViewModel">
    <Grid x:Name="Viewport" SizeChanged="OnViewportSizeChanged">
        <Grid x:Name="DesignRoot" WidthRequest="1920" HeightRequest="1080" HorizontalOptions="Start" VerticalOptions="Start" AnchorX="0" AnchorY="0">
            <Image Source="common_bg.png" Aspect="Fill" />
            <AbsoluteLayout WidthRequest="1920" HeightRequest="1080">
                <Button AbsoluteLayout.LayoutBounds="24,24,132,52" Text="← 返回" FontSize="24" FontAttributes="Bold" TextColor="White" BackgroundColor="#315F98" BorderColor="#18F7FF" BorderWidth="1" CornerRadius="8" Clicked="OnBackClicked" />
                <Grid AbsoluteLayout.LayoutBounds="116,88,1688,64" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <Label Grid.Column="0" Text="{Binding PageTitle}" TextColor="White" FontSize="42" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="{Binding OrderCountText}" TextColor="#B8D6F5" FontSize="24" FontAttributes="Bold" VerticalTextAlignment="Center" />
                </Grid>
                <Border AbsoluteLayout.LayoutBounds="116,174,1688,730" Stroke="#3B73AA" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#CC102947" Padding="28">
                    <Grid>
                        <CollectionView ItemsSource="{Binding Orders}" IsVisible="{Binding HasOrders}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:OrderListItem">
                                    <Border Margin="0,0,0,18" Padding="24" Stroke="#2F669B" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#66132642">
                                        <Grid RowDefinitions="54,Auto,54" RowSpacing="12">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24">
                                                <Label Grid.Column="0" Text="{Binding OrderNo}" FontSize="28" FontAttributes="Bold" TextColor="White" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="{Binding CreatedAtText}" FontSize="22" TextColor="#B8D6F5" VerticalTextAlignment="Center" />
                                                <Border Grid.Column="2" Padding="18,6" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#3318F7FF" VerticalOptions="Center">
                                                    <Label Text="{Binding Status}" FontSize="22" FontAttributes="Bold" TextColor="#18F7FF" />
                                                </Border>
                                            </Grid>
                                            <VerticalStackLayout Grid.Row="1" Spacing="8" BindableLayout.ItemsSource="{Binding Items}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="m:OrderLineItem">
                                                        <Grid ColumnDefinitions="*,120,180" ColumnSpacing="20" HeightRequest="38">
                                                            <Label Grid.Column="0" Text="{Binding ProductName}" FontSize="22" TextColor="#D7ECFF" MaxLines="1" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" />
                                                            <Label Grid.Column="1" Text="{Binding QuantityText}" FontSize="22" TextColor="#B8D6F5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                            <Label Grid.Column="2" Text="{Binding UnitPriceText}" FontSize="22" TextColor="#D7ECFF" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,190" ColumnSpacing="16">
                                                <Label Grid.Column="0" Text="{Binding SummaryText}" TextColor="#B8D6F5" FontSize="22" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="1" Text="订单金额" TextColor="White" FontSize="24" FontAttributes="Bold" VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2" Text="{Binding TotalAmountText}" TextColor="#18F7FF" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}" TextColor="#B8D6F5" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border AbsoluteLayout.LayoutBounds="116,926,1688,100" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#E6315F98" Padding="32,0">
                    <Grid ColumnDefinitions="*,Auto,220" ColumnSpacing="28">
                        <Label Grid.Column="0" Text="{Binding OrderCountText}" TextColor="#D7ECFF" FontSize="26" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="总金额" TextColor="White" FontSize="30" FontAttributes="Bold" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="{Binding TotalAmountText}" TextColor="#18F7FF" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
            </AbsoluteLayout>
        </Grid>
    </Grid>
</ContentPage>
