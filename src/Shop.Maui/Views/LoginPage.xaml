<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Shop.Maui.ViewModels"
             x:Class="Shop.Maui.Views.LoginPage"
             Title="登录"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#071629"
             x:DataType="vm:LoginViewModel">

    <Grid x:Name="Viewport"
          SizeChanged="OnViewportSizeChanged">
        <Grid x:Name="DesignRoot"
              WidthRequest="1920"
              HeightRequest="1080"
              HorizontalOptions="Start"
              VerticalOptions="Start"
              AnchorX="0"
              AnchorY="0">

            <Image Source="common_bg.png"
                   Aspect="Fill" />

            <Grid ColumnDefinitions="1.05*,0.95*"
                  Padding="160,120">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="26"
                                     VerticalOptions="Center">
                    <Label Text="Hello!"
                           TextColor="White"
                           FontSize="82"
                           FontAttributes="Bold" />
                    <Label Text="欢迎使用软体 AI 服务平台"
                           TextColor="#D7ECFF"
                           FontSize="34"
                           FontAttributes="Bold" />
                    <Label Text="默认账号：admin / 123456"
                           TextColor="#8FEFFF"
                           FontSize="24" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        WidthRequest="620"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="52,46"
                        Stroke="#66B8D6F5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 42"
                        BackgroundColor="#B02A2946">
                    <VerticalStackLayout Spacing="28">
                        <Label Text="登录"
                               TextColor="White"
                               FontSize="48"
                               FontAttributes="Bold" />

                        <VerticalStackLayout Spacing="12">
                            <Label Text="账号"
                                   TextColor="White"
                                   FontSize="22"
                                   FontAttributes="Bold" />
                            <Entry Text="{Binding Account}"
                                   Placeholder="请输入账号 / 手机号"
                                   TextColor="White"
                                   PlaceholderColor="#9EB4D4"
                                   FontSize="22"
                                   HeightRequest="58"
                                   BackgroundColor="#22132642" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="密码"
                                   TextColor="White"
                                   FontSize="22"
                                   FontAttributes="Bold" />
                            <Entry Text="{Binding Password}"
                                   Placeholder="请输入密码"
                                   IsPassword="True"
                                   TextColor="White"
                                   PlaceholderColor="#9EB4D4"
                                   FontSize="22"
                                   HeightRequest="58"
                                   BackgroundColor="#22132642" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto"
                              Margin="0,-4,0,0">
                            <HorizontalStackLayout Grid.Column="0"
                                                   Spacing="10"
                                                   VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding RememberAccount}"
                                          Color="#18F7FF" />
                                <Label Text="记住账号"
                                       TextColor="#D7ECFF"
                                       FontSize="20"
                                       VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Button Grid.Column="1"
                                    Text="注册账号"
                                    Command="{Binding GoToRegisterCommand}"
                                    FontSize="20"
                                    TextColor="#18F7FF"
                                    BackgroundColor="Transparent"
                                    Padding="0" />
                        </Grid>

                        <Button Text="登录"
                                Command="{Binding LoginCommand}"
                                HeightRequest="72"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#071629"
                                BackgroundColor="#D9EEFF"
                                CornerRadius="36" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
